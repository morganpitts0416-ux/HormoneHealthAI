 // ── Helpers ────────────────────────────────────────────────────────────────────
 
+export type BillingOwnerSnapshot = {
+  actorUserId: number;
+  actorDefaultClinicId: number | null;
+  clinicId: number | null;
+  clinicOwnerUserId: number | null;
+  activeOwnerMembershipUserIds: number[];
+  userStripeCustomerId: string | null;
+  userStripeSubscriptionId: string | null;
+  clinicStripeCustomerId: string | null;
+  clinicStripeSubscriptionId: string | null;
+};
+
+export type BillingOwnerAssessment = {
+  isClinicOwner: boolean;
+  stripeLinkageVerified: boolean;
+  canManageBilling: boolean;
+  reason:
+    | "verified"
+    | "clinic_missing"
+    | "clinic_mismatch"
+    | "owner_ambiguous"
+    | "owner_mismatch"
+    | "stripe_linkage_missing"
+    | "stripe_linkage_mismatch";
+};
+
+/**
+ * Billing authority is intentionally strict: the active clinic, clinic owner,
+ * and the single active owner membership must all identify the same user.
+ * When a subscription exists, both clinic and user Stripe links must also
+ * exist and match. No fallback is authoritative on its own.
+ */
+export function assessBillingOwner(snapshot: BillingOwnerSnapshot): BillingOwnerAssessment {
+  if (!snapshot.clinicId || !snapshot.actorDefaultClinicId) {
+    return { isClinicOwner: false, stripeLinkageVerified: false, canManageBilling: false, reason: "clinic_missing" };
+  }
+  if (snapshot.clinicId !== snapshot.actorDefaultClinicId) {
+    return { isClinicOwner: false, stripeLinkageVerified: false, canManageBilling: false, reason: "clinic_mismatch" };
+  }
+  if (
+    snapshot.activeOwnerMembershipUserIds.length !== 1 ||
+    snapshot.activeOwnerMembershipUserIds[0] !== snapshot.clinicOwnerUserId
+  ) {
+    return { isClinicOwner: false, stripeLinkageVerified: false, canManageBilling: false, reason: "owner_ambiguous" };
+  }
+  if (snapshot.clinicOwnerUserId !== snapshot.actorUserId) {
+    return { isClinicOwner: false, stripeLinkageVerified: false, canManageBilling: false, reason: "owner_mismatch" };
+  }
+
+  const hasSubscriptionLink =
+    !!snapshot.userStripeSubscriptionId || !!snapshot.clinicStripeSubscriptionId;
+  const hasCustomerLink =
+    !!snapshot.userStripeCustomerId || !!snapshot.clinicStripeCustomerId;
+  const customerLinkVerified =
+    !!snapshot.userStripeCustomerId &&
+    (!snapshot.clinicStripeCustomerId ||
+      snapshot.clinicStripeCustomerId === snapshot.userStripeCustomerId);
+  const subscriptionLinkVerified =
+    !!snapshot.userStripeSubscriptionId &&
+    snapshot.userStripeSubscriptionId === snapshot.clinicStripeSubscriptionId;
+  const stripeLinkageVerified =
+    !hasSubscriptionLink && !hasCustomerLink
+      ? true
+      : customerLinkVerified && subscriptionLinkVerified;
+
+  if (!stripeLinkageVerified) {
+    const missing =
+      !snapshot.userStripeCustomerId ||
+      !snapshot.userStripeSubscriptionId ||
+      !snapshot.clinicStripeCustomerId ||
+      !snapshot.clinicStripeSubscriptionId;
+    return {
+      isClinicOwner: true,
+      stripeLinkageVerified: false,
+      canManageBilling: false,
+      reason: missing ? "stripe_linkage_missing" : "stripe_linkage_mismatch",
+    };
+  }
+
+  return { isClinicOwner: true, stripeLinkageVerified: true, canManageBilling: true, reason: "verified" };
+}
+
+export function canActorManageClinicBilling(input: {
+  isStaffSession: boolean;
+  actorUserId: number;
+  clinicOwnerUserId: number | null;
+  assessment: BillingOwnerAssessment | null;
+}): boolean {
+  return (
+    !input.isStaffSession &&
+    input.assessment?.canManageBilling === true &&
+    input.assessment.isClinicOwner === true &&
+    input.clinicOwnerUserId === input.actorUserId
+  );
+}
+
+export function isVerifiedWebhookOwnerCandidate(input: {
+  assessment: BillingOwnerAssessment | null;
+  resolvedOwnerUserId: number | null;
+  expectedOwnerUserId: number;
+  clinicStripeCustomerId: string | null;
+  eventCustomerId: string;
+  clinicStripeSubscriptionId: string | null;
+  eventSubscriptionId: string;
+}): boolean {
+  return (
+    input.assessment?.canManageBilling === true &&
+    input.resolvedOwnerUserId === input.expectedOwnerUserId &&
+    (!input.clinicStripeCustomerId ||
+      input.clinicStripeCustomerId === input.eventCustomerId) &&
+    input.clinicStripeSubscriptionId === input.eventSubscriptionId
+  );
+}
+
+export function isRecentBillingReauthProof(
+  proof: unknown,
+  expected: { userId: number; clinicId: number },
+  now = Date.now(),
+  ttlMs = 10 * 60 * 1000,
+): boolean {
+  const candidate = proof as any;
+  return (
+    candidate?.userId === expected.userId &&
+    candidate?.clinicId === expected.clinicId &&
+    typeof candidate?.authenticatedAt === "number" &&
+    now - candidate.authenticatedAt >= 0 &&
+    now - candidate.authenticatedAt <= ttlMs
+  );
+}
+
+export class BillingRenewalError extends Error {
+  constructor(
+    public readonly code:
+      | "subscription_not_found"
+      | "customer_mismatch"
+      | "subscription_not_mutable"
+      | "cancellation_not_scheduled",
+    message: string,
+  ) {
+    super(message);
+    this.name = "BillingRenewalError";
+  }
+}
+
+type RenewalAuditStage = "requested" | "completed" | "failed" | "undone";
+
+export type ScheduledCancellationDeps = {
+  retrieveSubscription: (subscriptionId: string) => Promise<any>;
+  updateSubscription: (
+    subscriptionId: string,
+    params: { cancel_at_period_end: boolean },
+  ) => Promise<any>;
+  persistLocalState: (state: {
+    cancelAtPeriodEnd: boolean;
+    currentPeriodEnd: Date | null;
+    status: string;
+  }) => Promise<void>;
+  audit: (
+    stage: RenewalAuditStage,
+    details: Record<string, string | number | boolean | null>,
+  ) => Promise<void>;
+};
+
+function stripeObjectId(value: unknown): string | null {
+  if (typeof value === "string") return value;
+  if (value && typeof value === "object" && typeof (value as any).id === "string") {
+    return (value as any).id;
+  }
+  return null;
+}
+
+export function normalizeStripeSubscriptionStatus(status: unknown): string {
+  switch (status) {
+    case "trialing":
+      return "trial";
+    case "active":
+    case "past_due":
+    case "incomplete":
+    case "paused":
+      return status;
+    case "canceled":
+    case "unpaid":
+    case "incomplete_expired":
+      return "canceled";
+    default:
+      return "incomplete";
+  }
+}
+
+/**
+ * The only authorized subscription mutation in this emergency patch.
+ * The required audit happens before Stripe. The current Stripe subscription is
+ * retrieved and customer-verified before cancel_at_period_end is changed.
+ */
+export async function applyScheduledCancellation(
+  input: {
+    subscriptionId: string;
+    expectedCustomerId: string;
+    cancelAtPeriodEnd: boolean;
+  },
+  deps: ScheduledCancellationDeps,
+): Promise<{ cancelAtPeriodEnd: boolean; currentPeriodEnd: Date | null; status: string }> {
+  const operation = input.cancelAtPeriodEnd ? "schedule" : "undo";
+  await deps.audit("requested", { operation });
+
+  try {
+    const current = await deps.retrieveSubscription(input.subscriptionId);
+    if (!current || current.id !== input.subscriptionId || current.deleted === true) {
+      throw new BillingRenewalError("subscription_not_found", "Subscription could not be verified");
+    }
+    if (stripeObjectId(current.customer) !== input.expectedCustomerId) {
+      throw new BillingRenewalError("customer_mismatch", "Subscription ownership could not be verified");
+    }
+    if (!["active", "trialing"].includes(current.status)) {
+      throw new BillingRenewalError("subscription_not_mutable", "Subscription cannot be changed in its current state");
+    }
+    if (!input.cancelAtPeriodEnd && current.cancel_at_period_end !== true) {
+      throw new BillingRenewalError("cancellation_not_scheduled", "No scheduled cancellation was found");
+    }
+
+    const changed =
+      current.cancel_at_period_end === input.cancelAtPeriodEnd
+        ? current
+        : await deps.updateSubscription(input.subscriptionId, {
+            cancel_at_period_end: input.cancelAtPeriodEnd,
+          });
+
+    if (!changed || changed.id !== input.subscriptionId) {
+      throw new BillingRenewalError("subscription_not_found", "Subscription update could not be verified");
+    }
+    if (stripeObjectId(changed.customer) !== input.expectedCustomerId) {
+      throw new BillingRenewalError("customer_mismatch", "Updated subscription ownership could not be verified");
+    }
+
+    const currentPeriodEnd =
+      stripeTsForBilling(changed.current_period_end) ??
+      stripeTsForBilling(changed.trial_end);
+    const status = normalizeStripeSubscriptionStatus(changed.status);
+    await deps.persistLocalState({
+      cancelAtPeriodEnd: input.cancelAtPeriodEnd,
+      currentPeriodEnd,
+      status,
+    });
+    await deps.audit(input.cancelAtPeriodEnd ? "completed" : "undone", {
+      operation,
+      cancelAtPeriodEnd: input.cancelAtPeriodEnd,
+      effectiveAt: currentPeriodEnd?.toISOString() ?? null,
+      status,
+    });
+
+    return { cancelAtPeriodEnd: input.cancelAtPeriodEnd, currentPeriodEnd, status };
+  } catch (error) {
+    const code = error instanceof BillingRenewalError ? error.code : "internal_error";
+    try {
+      await deps.audit("failed", { operation, errorCode: code });
+    } catch {
+      // The requested audit was already awaited before Stripe. Never expose or
+      // log the original Stripe/database error while handling audit failure.
+    }
+    throw error;
+  }
+}
+
+function stripeTsForBilling(unixSeconds: number | null | undefined): Date | null {
+  if (unixSeconds == null || unixSeconds === 0) return null;
+  const value = new Date(unixSeconds * 1000);
+  return Number.isNaN(value.getTime()) ? null : value;
+}
