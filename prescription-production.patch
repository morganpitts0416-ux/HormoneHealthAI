+++ b/server/prescription-release-preflight.sql
@@ -0,0 +1,26 @@
+-- READ ONLY; safe operator template, NOT automatically executed.
+-- Verify the actual target, approved schema baseline and backing database first.
+SELECT table_name, column_name, data_type, is_nullable, column_default,
+       character_maximum_length
+FROM information_schema.columns
+WHERE table_schema = 'public' AND (
+  table_name LIKE 'prescription_%' OR table_name = 'prescriptions' OR
+  table_name IN ('prescriber_credentials','prescriber_credential_audit_events') OR
+  (table_name = 'clinics' AND column_name IN ('id','address','phone'))
+) ORDER BY table_name, ordinal_position;
+SELECT tablename, indexname, indexdef FROM pg_indexes
+WHERE schemaname = 'public' AND (
+  tablename LIKE 'prescription_%' OR tablename IN ('prescriptions','prescriber_credentials','prescriber_credential_audit_events')
+) ORDER BY tablename, indexname;
+SELECT conrelid::regclass AS relation, conname, pg_get_constraintdef(oid), convalidated
+FROM pg_constraint
+WHERE conrelid::regclass::text LIKE 'prescription_%'
+   OR conrelid::regclass::text IN ('prescriptions','prescriber_credentials','prescriber_credential_audit_events');
+-- Run the following ONLY when the corresponding tables exist. These expose
+-- aggregate counts, not patient or signature data. Stop on any nonzero count.
+SELECT count(*) AS duplicate_documents FROM
+  (SELECT prescription_id FROM prescription_documents GROUP BY prescription_id HAVING count(*) > 1) duplicates;
+SELECT count(*) AS cross_clinic_documents FROM prescription_documents d
+JOIN prescriptions p ON p.id = d.prescription_id WHERE d.clinic_id <> p.clinic_id;
+SELECT count(*) AS cross_clinic_sigs FROM prescription_sigs s
+JOIN prescription_medications m ON m.id = s.medication_id WHERE s.clinic_id <> m.clinic_id;
diff --git a/server/prescription-release-schema.sql b/server/prescription-release-schema.sql
new file mode 100644
--- /dev/null
+++ b/server/prescription-release-schema.sql
@@ -0,0 +1,29 @@
+-- REVIEW ONLY: never invoked by application startup.
+-- Apply AFTER target-schema inspection, backup and explicit approval.
+BEGIN;
+-- Preserve the authoritative clinic contacts already used by clinical orders.
+-- Existing prescription_address/phone columns, if any, are not dropped or copied.
+ALTER TABLE clinics ADD COLUMN IF NOT EXISTS address text;
+ALTER TABLE clinics ADD COLUMN IF NOT EXISTS phone varchar(30);
+ALTER TABLE prescriber_credentials ADD COLUMN IF NOT EXISTS verified_npi varchar(10);
+ALTER TABLE prescriber_credential_audit_events ADD COLUMN IF NOT EXISTS credential_snapshot jsonb;
+-- No backfill from users.phone/address: these can be personal or another clinic.
+-- Existing approvals need independent NPI re-verification; never auto-authorize.
+CREATE UNIQUE INDEX IF NOT EXISTS prescriptions_id_clinic_idx ON prescriptions(id, clinic_id);
+CREATE UNIQUE INDEX IF NOT EXISTS prescription_medications_id_clinic_idx ON prescription_medications(id, clinic_id);
+DO $$
+BEGIN
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname='prescription_documents_tenant_fk' AND conrelid='prescription_documents'::regclass) THEN
+    ALTER TABLE prescription_documents ADD CONSTRAINT prescription_documents_tenant_fk
+      FOREIGN KEY (prescription_id, clinic_id) REFERENCES prescriptions(id, clinic_id) NOT VALID;
+  END IF;
+  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname='prescription_sigs_tenant_fk' AND conrelid='prescription_sigs'::regclass) THEN
+    ALTER TABLE prescription_sigs ADD CONSTRAINT prescription_sigs_tenant_fk
+      FOREIGN KEY (medication_id, clinic_id) REFERENCES prescription_medications(id, clinic_id) NOT VALID;
+  END IF;
+END $$;
+-- Fail/roll back if historical rows have tenant mismatches; NEVER repair/delete
+-- them automatically. Preflight and explicit review are prerequisites.
+ALTER TABLE prescription_documents VALIDATE CONSTRAINT prescription_documents_tenant_fk;
+ALTER TABLE prescription_sigs VALIDATE CONSTRAINT prescription_sigs_tenant_fk;
+COMMIT;
