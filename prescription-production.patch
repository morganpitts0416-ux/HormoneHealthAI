+++ b/server/prescription-log-policy.ts
@@ -0,0 +1,8 @@
+/** Prescription HTTP logs must contain no record IDs or response contents. */
+export function safePrescriptionHttpLog(method: string, path: string, status: number, duration: number): string | null {
+  const normalized = path.toLowerCase();
+  if (!normalized.startsWith("/api/prescription") &&
+      !normalized.startsWith("/api/prescriber-") &&
+      !/^\/api\/patients\/[^/]+\/prescriptions(?:\/|$)/.test(normalized)) return null;
+  return `${method} [prescription] ${status} in ${duration}ms :: [redacted]`;
+}
diff --git a/server/prescription-medication-policy.ts b/server/prescription-medication-policy.ts
new file mode 100644
--- /dev/null
+++ b/server/prescription-medication-policy.ts
@@ -0,0 +1,60 @@
+import fs from "node:fs";
+import { z } from "zod";
+import type { Prescription } from "@shared/schema";
+import { PrescriptionError } from "./prescription-finalization";
+
+// A small, pharmacist-reviewed server-side formulary, not a controlled-drug
+// classifier. Unknown names, brands, combinations and compounds fail closed.
+const entrySchema = z.object({
+  medicationName: z.string().trim().min(1),
+  strength: z.string().trim().min(1),
+  dosageForm: z.string().trim().min(1),
+  noncontrolled: z.literal(true),
+  sourceReference: z.string().trim().min(1),
+  reviewedBy: z.string().trim().min(1),
+  reviewedAt: z.string().datetime(),
+  expiresAt: z.string().datetime(),
+}).strict();
+const catalogSchema = z.array(entrySchema).min(1);
+const normalize = (value: string | null) => (value ?? "").trim().replace(/\s+/g, " ").toLowerCase();
+
+export function validateNoncontrolledCatalog(input: unknown, now = new Date()) {
+  const catalog = catalogSchema.safeParse(input);
+  if (!catalog.success) throw new PrescriptionError(422, "Invalid reviewed medication catalog");
+  const identities = new Set<string>();
+  for (const entry of catalog.data) {
+    const identity = [entry.medicationName, entry.strength, entry.dosageForm].map(normalize).join("\u0000");
+    if (identities.has(identity)) throw new PrescriptionError(422, "Duplicate medication formulation");
+    identities.add(identity);
+    if (new Date(entry.reviewedAt) > now || new Date(entry.expiresAt) <= new Date(entry.reviewedAt)) {
+      throw new PrescriptionError(422, "Invalid medication review dates");
+    }
+  }
+  return catalog.data;
+}
+
+export function requireNoncontrolledMedication(rx: Prescription, input: unknown, now = new Date()) {
+  let catalog: ReturnType<typeof validateNoncontrolledCatalog>;
+  try { catalog = validateNoncontrolledCatalog(input, now); }
+  catch { throw new PrescriptionError(422, "Medication is not eligible"); }
+  if (rx.isControlledSubstance) {
+    throw new PrescriptionError(422, "Medication is not eligible");
+  }
+  const match = catalog.find(entry =>
+    normalize(entry.medicationName) === normalize(rx.medicationName) &&
+    normalize(entry.strength) === normalize(rx.strength) &&
+    normalize(entry.dosageForm) === normalize(rx.dosageForm) &&
+    new Date(entry.reviewedAt) <= now && new Date(entry.expiresAt) > now);
+  if (!match) throw new PrescriptionError(422, "Medication is not eligible");
+  return { ...match };
+}
+
+export function classifyPrescription(rx: Prescription) {
+  try {
+    const file = process.env.PRESCRIPTION_NONCONTROLLED_CATALOG_PATH;
+    if (!file) throw new Error("Missing catalog");
+    return requireNoncontrolledMedication(rx, JSON.parse(fs.readFileSync(file, "utf8")));
+  } catch {
+    throw new PrescriptionError(422, "Medication is not eligible");
+  }
+}
diff --git a/server/prescription-pdf.ts b/server/prescription-pdf.ts
new file mode 100644
--- /dev/null
+++ b/server/prescription-pdf.ts
@@ -0,0 +1,246 @@
+import { jsPDF } from "jspdf";
+
+export interface PrescriptionPdfData {
+  clinicName: string;
+  clinicAddress?: string | null;
+  clinicPhone?: string | null;
+  patientName: string;
+  patientDob: Date | string | null;
+  patientAddress?: string | null;
+  medicationName: string;
+  strength?: string | null;
+  dosageForm?: string | null;
+  sig: string;
+  quantity: string;
+  refills: number;
+  substitutionAllowed: boolean;
+  pharmacyName?: string | null;
+  pharmacyAddress?: string | null;
+  pharmacyPhone?: string | null;
+  pharmacyFax?: string | null;
+  dose?: string | null;
+  route?: string | null;
+  frequency?: string | null;
+  daysSupply?: number | null;
+  prescriberName: string;
+  prescriberTitle?: string | null;
+  signatureImage?: string | null;
+  prescriberNpi?: string | null;
+  prescriberLicense?: string | null;
+  prescriberLicenseState?: string | null;
+  signedAt: Date;
+}
+
+export function generatePrescriptionPdf(data: PrescriptionPdfData): Buffer {
+  if (!/^data:image\/(?:png|jpeg);base64,/.test(data.signatureImage ?? "")) {
+    throw new Error("A valid saved prescriber signature is required");
+  }
+  if (!data.clinicAddress?.trim() || !data.clinicPhone?.trim()) {
+    throw new Error("Reviewed clinic address and phone are required");
+  }
+  const pdf = new jsPDF({ unit: "pt", format: "letter" });
+  pdf.setCreationDate(data.signedAt);
+
+  const LEFT = 50;
+  const RIGHT = 562;
+  const TOP = 48;
+  const BOTTOM = 744;
+  const LINE_HEIGHT = 15;
+
+  let y = TOP;
+
+  const newPage = () => {
+    pdf.addPage();
+    y = TOP;
+  };
+
+  const ensureSpace = (height: number) => {
+    if (y + height > BOTTOM) newPage();
+  };
+
+  const space = (height: number) => {
+    ensureSpace(height);
+    y += height;
+  };
+
+  const line = (
+    label: string,
+    value?: string | number | null
+  ) => {
+    if (value === null || value === undefined || value === "") return;
+
+    const content = `${label}: ${value}`;
+    const wrapped = pdf.splitTextToSize(content, RIGHT - LEFT);
+
+    for (const textLine of wrapped) {
+      ensureSpace(LINE_HEIGHT);
+      pdf.text(textLine, LEFT, y);
+      y += LINE_HEIGHT;
+    }
+
+    space(5);
+  };
+
+  const heading = (text: string) => {
+    ensureSpace(40);
+    pdf.setFont("helvetica", "bold");
+    pdf.setFontSize(12);
+    pdf.text(text, LEFT, y);
+    y += 25;
+    pdf.setFont("helvetica", "normal");
+    pdf.setFontSize(10);
+  };
+
+  pdf.setFont("helvetica", "bold");
+  pdf.setFontSize(17);
+
+  const clinicLines = pdf.splitTextToSize(data.clinicName, RIGHT - LEFT);
+  for (const clinicLine of clinicLines) {
+    ensureSpace(23);
+    pdf.text(clinicLine, LEFT, y);
+    y += 23;
+  }
+
+  pdf.setFont("helvetica", "normal");
+  pdf.setFontSize(10);
+
+  line("Address", data.clinicAddress);
+  line("Phone", data.clinicPhone);
+
+  space(12);
+  ensureSpace(30);
+  pdf.line(LEFT, y, RIGHT, y);
+  y += 25;
+
+  heading("PRESCRIPTION");
+
+  line("Patient", data.patientName);
+
+  const dob = data.patientDob
+    ? new Date(data.patientDob).toLocaleDateString("en-US", {
+        timeZone: "UTC",
+      })
+    : "Not recorded";
+
+  line("DOB", dob);
+  line("Patient Address", data.patientAddress);
+  line("Date Signed", data.signedAt.toISOString());
+
+  space(15);
+  heading("Rx");
+
+  line("Medication", data.medicationName);
+  line("Strength", data.strength);
+  line("Form", data.dosageForm);
+  line("Dose", data.dose || "See SIG");
+  line("Route", data.route || "See SIG");
+  line("Frequency", data.frequency || "See SIG");
+  line("Directions", data.sig);
+  line("Quantity", data.quantity);
+  line("Refills", data.refills);
+  line("Days Supply", data.daysSupply);
+  line(
+    "Substitution",
+    data.substitutionAllowed ? "Allowed" : "Dispense as written"
+  );
+
+  space(15);
+  line("Pharmacy", data.pharmacyName);
+  line("Pharmacy Address", data.pharmacyAddress);
+  line("Pharmacy Phone", data.pharmacyPhone);
+  line("Pharmacy Fax", data.pharmacyFax);
+
+  // Calculate the complete signature block before drawing it. Long provider
+  // names/licenses must not overflow the page or separate identity from signature.
+  const prescriberLabel = [data.prescriberName, data.prescriberTitle].filter(Boolean).join(", ");
+  pdf.setFontSize(10);
+  const identityLines = [
+    ["Prescriber", prescriberLabel], ["NPI", data.prescriberNpi],
+    ["License", data.prescriberLicense], ["License State", data.prescriberLicenseState],
+  ].reduce((count, [label, value]) => value
+    ? count + pdf.splitTextToSize(`${label}: ${value}`, RIGHT - LEFT).length : count, 0);
+  const signerLines: string[] = pdf.splitTextToSize(prescriberLabel, RIGHT - LEFT);
+  const signatureHeight = 180 + identityLines * LINE_HEIGHT + signerLines.length * 16;
+  if (signatureHeight > BOTTOM - TOP) throw new Error("Prescriber details exceed prescription page limits");
+  ensureSpace(signatureHeight);
+
+  space(20);
+  pdf.line(LEFT, y, RIGHT, y);
+  y += 25;
+
+  // Render the prescriber's saved signature.
+  if (data.signatureImage) {
+    try {
+      const imageType = data.signatureImage.includes("image/png")
+        ? "PNG"
+        : "JPEG";
+
+      const properties = pdf.getImageProperties(data.signatureImage);
+      const ratio = Math.min(110 / properties.width, 36 / properties.height);
+      pdf.addImage(
+        data.signatureImage,
+        imageType,
+        LEFT,
+        y,
+        properties.width * ratio,
+        properties.height * ratio,
+        undefined,
+        "FAST"
+      );
+
+      y += 45;
+    } catch (error) {
+      throw new Error("Unable to render prescriber signature");
+    }
+  }
+
+  pdf.setFont("helvetica", "bold");
+
+  line(
+    "Prescriber",
+    `${data.prescriberName}${
+      data.prescriberTitle ? ", " + data.prescriberTitle : ""
+    }`
+  );
+
+  pdf.setFont("helvetica", "normal");
+
+  line("NPI", data.prescriberNpi);
+  line("License", data.prescriberLicense);
+  line("License State", data.prescriberLicenseState);
+
+  space(15);
+  ensureSpace(55);
+
+  pdf.setFont("helvetica", "bold");
+  pdf.setFontSize(10);
+  pdf.text("Electronically signed by:", LEFT, y);
+
+  y += 16;
+
+  pdf.setFont("helvetica", "normal");
+  pdf.setFontSize(10);
+
+  for (const signerLine of signerLines) {
+    pdf.text(signerLine, LEFT, y);
+    y += 16;
+  }
+
+  pdf.setFontSize(9);
+  pdf.text(
+    `Date signed (UTC): ${data.signedAt.toISOString()}`,
+    LEFT,
+    y
+  );
+
+  y += 16;
+
+  pdf.setFontSize(8);
+  pdf.text(
+    "Electronically authenticated through ClinIQ.",
+    LEFT,
+    y
+  );
+
+  return Buffer.from(pdf.output("arraybuffer"));
+}
