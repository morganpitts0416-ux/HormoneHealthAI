@@ -0,0 +1,66 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { generatePrescriptionPdf } from "../../server/prescription-pdf";
+import { validateNoncontrolledCatalog, requireNoncontrolledMedication } from "../../server/prescription-medication-policy";
+import { syntheticSignature } from "./prescription-fixtures";
+
+const now = new Date("2030-01-02T00:00:00Z");
+const entry = {
+  medicationName: "Synthetic Medication", strength: "25 mg", dosageForm: "tablet",
+  noncontrolled: true, sourceReference: "SYNTHETIC TEST ONLY",
+  reviewedBy: "Synthetic clinical reviewer", reviewedAt: "2030-01-01T00:00:00Z",
+  expiresAt: "2031-01-01T00:00:00Z",
+};
+const data = {
+  clinicName: "Synthetic Clinic", clinicAddress: "100 Example Business Avenue", clinicPhone: "555-0100",
+  patientName: "Synthetic Patient", patientDob: "1990-01-01", medicationName: entry.medicationName,
+  strength: entry.strength, dosageForm: entry.dosageForm, sig: "Synthetic directions only",
+  quantity: "30", refills: 0, substitutionAllowed: true, prescriberName: "Synthetic Provider",
+  prescriberNpi: "1234567890", prescriberLicense: "SYNTHETIC-ONLY",
+  prescriberLicenseState: "MS", signatureImage: syntheticSignature, signedAt: now,
+};
+
+describe("Prescription release compatibility", () => {
+  it("allows an externally configured, reviewed formulation without editing code", () => {
+    const rx = { ...entry, medicationName: " synthetic   medication ", isControlledSubstance: false } as any;
+    expect(requireNoncontrolledMedication(rx, [entry], now).sourceReference).toBe(entry.sourceReference);
+  });
+  it("rejects duplicate normalized formulations and inconsistent review dates", () => {
+    expect(() => validateNoncontrolledCatalog([entry, { ...entry, strength: "25  mg" }], now)).toThrow("Duplicate");
+    expect(() => validateNoncontrolledCatalog([{ ...entry, reviewedAt: "2032-01-01T00:00:00Z" }], now)).toThrow("review dates");
+    expect(() => validateNoncontrolledCatalog([{ ...entry, expiresAt: entry.reviewedAt }], now)).toThrow("review dates");
+  });
+  it("creates a complete PDF with clinic business contacts, identity, signature and explicit SIG", () => {
+    const bytes = generatePrescriptionPdf(data);
+    const text = bytes.toString("latin1");
+    expect(text.startsWith("%PDF-")).toBe(true);
+    expect(text.trimEnd().endsWith("%%EOF")).toBe(true);
+    for (const field of [data.clinicAddress, data.clinicPhone, data.sig, "See SIG", data.prescriberLicense, data.prescriberNpi]) {
+      expect(text).toContain(field);
+    }
+    expect(text).toContain("/Subtype /Image");
+    expect(text).toContain("Electronically authenticated through ClinIQ.");
+  });
+  it("wraps long identities and moves the complete signature block to a later page", () => {
+    const bytes = generatePrescriptionPdf({ ...data, sig: "Synthetic long directions. ".repeat(150),
+      prescriberName: "Synthetic Long Provider Name ".repeat(6) });
+    const text = bytes.toString("latin1");
+    expect((text.match(/\/Type \/Page\b/g) ?? []).length).toBeGreaterThan(1);
+    expect(text).toContain("/Subtype /Image");
+    expect(text).toContain(data.prescriberNpi);
+    expect(text.trimEnd().endsWith("%%EOF")).toBe(true);
+  });
+  it("keeps authoritative clinic contacts and removes broad startup mutation", () => {
+    const schema = readFileSync("shared/schema.ts", "utf8");
+    expect(schema).toContain('address: text("address")');
+    expect(schema).toContain('phone: varchar("phone", { length: 30 })');
+    const startup = readFileSync("server/index.ts", "utf8");
+    expect(startup).not.toMatch(/await\s+ensureSchema\s*\(/);
+    expect(startup).not.toMatch(/await\s+storage\.archivePatientsWithNoAppointments\s*\(/);
+  });
+  it("uses patched PDF and proxy dependency versions", () => {
+    const lock = JSON.parse(readFileSync("package-lock.json", "utf8")).packages;
+    expect(lock["node_modules/jspdf"].version).toBe("4.2.1");
+    expect(lock["node_modules/proxy-addr"].version).toBe("2.0.8");
+  });
+});
