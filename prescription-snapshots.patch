+${row("Patient address", d.patientAddress)}${row("Patient phone", d.patientPhone)}
+${row("Date signed (UTC)", snapshot.signedAt)}</dl><h2 class="rx">Rx</h2><dl>
+${row("Medication", [d.medicationName,d.strength,d.dosageForm].filter(Boolean).join(" "))}
+${row("Directions", d.sig)}${row("Dose",d.dose)}${row("Route",d.route)}${row("Frequency",d.frequency)}
+${row("Quantity",d.quantity)}${row("Days supply",d.daysSupply)}${row("Refills",d.refills)}
+${row("Indication",d.indication)}${row("Substitution",d.substitutionAllowed ? "Permitted" : "Dispense as written")}
+</dl><h2>Pharmacy</h2><dl>${row("Name",d.pharmacyName)}${row("Address",d.pharmacyAddress)}
+${row("Phone",d.pharmacyPhone)}${row("Fax",d.pharmacyFax)}</dl><h2>Prescriber</h2><dl>
+${row("Name",[d.prescriberName,d.prescriberTitle].filter(Boolean).join(", "))}
+${row("NPI",d.prescriberNpi)}${row("License",`${d.prescriberLicense} (${d.prescriberLicenseState})`)}</dl>
+<div class="signature">${image(d.signatureImage,"Prescriber handwritten signature")}</div>
+<div class="auth">${escape(snapshot.authenticationStatement)}<br>
+Signed (UTC): ${escape(snapshot.signedAt)}<br>Prescription ${snapshot.prescriptionId} · SHA-256: ${escape(snapshot.sha256)}</div>
+</main></body></html>`;
+}
