+    expect((await pool.query("select current_database() as name")).rows[0].name).toBe("cliniq_synthetic");
+    state.db = drizzle(pool, { schema });
+    // Base application auth tables, ORM-identical column types; no live migrations.
+    // Prescription tables and constraints use the actual prepared release SQL.
+    for (const table of [schema.users, schema.clinics, schema.patients, schema.clinicMemberships,
+      schema.clinicianStaff, schema.clinicalEncounters]) {
+      const columns = Object.entries(getTableColumns(table)).map(([key, column]) =>
+        `"${column.name}" ${key === "id" ? "integer PRIMARY KEY" : column.getSQLType()}`);
+      await pool.query(`CREATE TABLE "${getTableName(table)}" (${columns.join(",")})`);
+    }
