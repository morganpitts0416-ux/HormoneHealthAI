index 0000000000000000000000000000000000000000..9436d99b8165ac5c1b0b4db1624e5de5378deb83
--- /dev/null
+++ b/client/src/components/prescription-timeline.tsx
@@ -0,0 +1,227 @@
+import { useState } from "react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import {
+  Dialog,
+  DialogContent,
+  DialogHeader,
+  DialogTitle,
+} from "@/components/ui/dialog";
+import { Download, FileText, Loader2, Pill, Printer } from "lucide-react";
+
+export interface TimelinePrescription {
+  id: number;
+  encounterId?: number | null;
+  hasSignedSnapshot?: boolean;
+  status: string;
+  signedAt?: string | null;
+  createdAt?: string | null;
+  batchId?: number | string | null;
+  medicationName: string;
+  strength?: string | null;
+  dosageForm?: string | null;
+  sig?: string | null;
+  quantity?: string | null;
+  refills?: number | null;
+  pharmacyName?: string | null;
+}
+
+export interface PrescriptionTimelineEncounter {
+  id: number;
+  visitDate: string | Date;
+}
+
+export type PrescriptionTimelineEvent<TEncounter extends PrescriptionTimelineEncounter> =
+  | { kind: "encounter"; encounter: TEncounter; sortMs: number }
+  | { kind: "prescription-group"; key: string; prescriptions: TimelinePrescription[]; sortMs: number };
+
+/** Interleave encounter rows with prescription batches by their own clinical dates. */
+export function mergePrescriptionTimeline<TEncounter extends PrescriptionTimelineEncounter>(
+  encounters: TEncounter[],
+  prescriptions: TimelinePrescription[],
+): PrescriptionTimelineEvent<TEncounter>[] {
+  const events: PrescriptionTimelineEvent<TEncounter>[] = encounters.map((encounter) => ({
+    kind: "encounter",
+    encounter,
+    sortMs: new Date(encounter.visitDate).getTime(),
+  }));
+  const groups = new Map<string, TimelinePrescription[]>();
+  for (const prescription of prescriptions) {
+    const key = prescription.batchId != null ? `batch-${prescription.batchId}` : `prescription-${prescription.id}`;
+    groups.set(key, [...(groups.get(key) ?? []), prescription]);
+  }
+  for (const [key, items] of Array.from(groups.entries())) {
+    const sortMs = Math.max(...items.map((item) => {
+      const date = item.signedAt ?? item.createdAt;
+      return date ? new Date(date).getTime() : 0;
+    }));
+    events.push({ kind: "prescription-group", key, prescriptions: items, sortMs });
+  }
+  return events.sort((a, b) => b.sortMs - a.sortMs);
+}
+
+function dateLabel(date: string | null | undefined) {
+  if (!date) return "Date unavailable";
+  const parsed = new Date(date);
+  return Number.isNaN(parsed.getTime())
+    ? "Date unavailable"
+    : parsed.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
+}
+
+export function PrescriptionTimelineGroup({
+  groupKey,
+  prescriptions,
+  onOpenDrafts,
+  onOpenEncounter,
+}: {
+  groupKey: string;
+  prescriptions: TimelinePrescription[];
+  onOpenDrafts: () => void;
+  onOpenEncounter?: (id: number) => void;
+}) {
+  const [viewingId, setViewingId] = useState<number | null>(null);
+  const [busyId, setBusyId] = useState<number | null>(null);
+  const [error, setError] = useState("");
+  const viewingPrescription = prescriptions.find((prescription) => prescription.id === viewingId);
+  const isBatch = prescriptions.length > 1;
+
+  async function downloadPdf(prescriptionId: number, print: boolean) {
+    setBusyId(prescriptionId);
+    setError("");
+    const printWindow = print ? window.open("about:blank", "_blank") : null;
+    try {
+      if (print && !printWindow) throw new Error("Allow pop-ups to print the finalized prescription PDF.");
+      const response = await fetch(`/api/prescriptions/${prescriptionId}/pdf`, { credentials: "include" });
+      if (!response.ok) throw new Error("Unable to retrieve the finalized prescription PDF.");
+      const blob = await response.blob();
+      if (!blob.size || (blob.type && !blob.type.includes("pdf"))) throw new Error("The server did not return a valid prescription PDF.");
+      const url = URL.createObjectURL(blob);
+      if (printWindow) {
+        printWindow.addEventListener("load", () => {
+          printWindow.focus();
+          printWindow.print();
+        }, { once: true });
+        printWindow.location.href = url;
+        window.setTimeout(() => URL.revokeObjectURL(url), 120_000);
+      } else {
+        const link = document.createElement("a");
+        link.href = url;
+        link.download = `prescription-${prescriptionId}.pdf`;
+        document.body.appendChild(link);
+        link.click();
+        link.remove();
+        window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
+      }
+    } catch (cause) {
+      printWindow?.close();
+      setError(cause instanceof Error ? cause.message : "Unable to open prescription PDF.");
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  return (
+    <>
+      <section
+        className="rounded-md border border-l-4 border-l-primary/60 bg-card p-3 space-y-2"
+        aria-label={isBatch ? "Prescription batch" : "Prescription"}
+        data-testid={`prescription-timeline-${groupKey}`}
+      >
+        <header className="flex items-center gap-2 flex-wrap">
+          <Pill className="h-3.5 w-3.5 text-primary" aria-hidden="true" />
+          <span className="text-xs font-semibold">{isBatch ? "Prescription batch" : "Prescription"}</span>
+          {isBatch && <Badge variant="secondary" className="text-[10px]">{prescriptions.length} medications</Badge>}
+          <span className="text-xs text-muted-foreground ml-auto">{dateLabel(prescriptions[0]?.signedAt ?? prescriptions[0]?.createdAt)}</span>
+        </header>
+        <div className="divide-y">
+          {prescriptions.map((prescription) => {
+            const signed = prescription.status === "signed";
+            const hasSnapshot = signed && prescription.hasSignedSnapshot === true;
+            return (
+              <article key={prescription.id} className="py-2 first:pt-0 last:pb-0 space-y-2">
+                <div className="flex items-start justify-between gap-3">
+                  <div className="min-w-0 space-y-0.5">
+                    <button
+                      type="button"
+                      className="text-left text-sm font-medium break-words hover:underline underline-offset-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-sm"
+                      onClick={() => {
+                        if (!signed) onOpenDrafts();
+                        else if (hasSnapshot) { setError(""); setViewingId(prescription.id); }
+                        else void downloadPdf(prescription.id, false);
+                      }}
+                      aria-label={signed
+                        ? `Open signed prescription for ${prescription.medicationName}`
+                        : `Open unsigned prescription draft for review: ${prescription.medicationName}`}
+                    >
+                      {prescription.medicationName}
+                      {prescription.strength ? ` — ${prescription.strength}` : ""}
+                      {prescription.dosageForm ? ` ${prescription.dosageForm}` : ""}
+                    </button>
+                    {prescription.sig && <p className="text-xs text-muted-foreground whitespace-pre-wrap">{prescription.sig}</p>}
+                    <p className="text-[11px] text-muted-foreground">
+                      {signed ? `Signed ${dateLabel(prescription.signedAt)}` : "Unsigned draft"}
+                    </p>
+                    {prescription.encounterId && onOpenEncounter && (
+                      <button type="button" className="text-xs underline"
+                        onClick={() => onOpenEncounter(prescription.encounterId!)}>
+                        Originating encounter #{prescription.encounterId}
+                      </button>
+                    )}
+                  </div>
+                  <Badge variant={signed ? "outline" : "secondary"} className="shrink-0">
+                    {signed ? "Signed" : "Unsigned draft"}
+                  </Badge>
+                </div>
+                <div className="flex flex-wrap gap-2">
+                  {signed && hasSnapshot && (
+                    <Button type="button" size="sm" variant="outline" onClick={() => { setError(""); setViewingId(prescription.id); }}>
+                      <FileText className="h-3.5 w-3.5 mr-1" /> View signed document
+                    </Button>
+                  )}
+                  {signed && (
+                    <>
+                      <Button type="button" size="sm" variant="outline" disabled={busyId !== null} onClick={() => void downloadPdf(prescription.id, false)}>
+                        {busyId === prescription.id ? <Loader2 className="h-3.5 w-3.5 mr-1 animate-spin" /> : <Download className="h-3.5 w-3.5 mr-1" />}
+                        Download PDF
+                      </Button>
+                      <Button type="button" size="sm" variant="outline" disabled={busyId !== null} onClick={() => void downloadPdf(prescription.id, true)}>
+                        {busyId === prescription.id ? <Loader2 className="h-3.5 w-3.5 mr-1 animate-spin" /> : <Printer className="h-3.5 w-3.5 mr-1" />}
+                        Print
+                      </Button>
+                    </>
+                  )}
+                  {!signed && (
+                    <Button type="button" size="sm" variant="outline" onClick={onOpenDrafts}>
+                      Review or edit unsigned draft
+                    </Button>
+                  )}
+                </div>
+              </article>
+            );
+          })}
+        </div>
+        {error && <p role="alert" className="text-xs text-destructive">{error}</p>}
+      </section>
+      <Dialog open={viewingId !== null} onOpenChange={(open) => { if (!open) setViewingId(null); }}>
+        <DialogContent className="w-[calc(100vw-1rem)] max-w-5xl h-[min(90dvh,900px)] flex flex-col p-0">
+          <DialogHeader className="px-5 pt-5">
+            <DialogTitle>Signed prescription</DialogTitle>
+            <p className="text-sm text-muted-foreground">
+              {viewingPrescription?.medicationName} — read-only signed snapshot
+            </p>
+          </DialogHeader>
+          {viewingId !== null && (
+            <iframe
+              key={viewingId}
+              title={`Signed prescription document for ${viewingPrescription?.medicationName ?? "medication"}`}
+              src={`/api/prescriptions/${viewingId}/html`}
+              className="min-h-0 flex-1 w-full border-t bg-white"
+              referrerPolicy="same-origin"
+              sandbox="allow-same-origin"
+            />
+          )}
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
