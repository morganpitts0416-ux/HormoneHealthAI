diff --git a/server/prescription-signing-transaction.ts b/server/prescription-signing-transaction.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2d08d3fbfb239c1f200a81ed69b5d4354d85b038
--- /dev/null
+++ b/server/prescription-signing-transaction.ts
@@ -0,0 +1,87 @@
+import { and, eq, sql } from "drizzle-orm";
+import type { db } from "./storage";
+import { clinics, patients, prescriptions, prescriptionBatches, clinicalEncounters,
+  prescriptionDocuments, prescriptionAuditEvents } from "@shared/schema";
+import { PrescriptionError, type SigningIdentity, type SigningTransaction } from "./prescription-finalization";
+
+type Transaction = Parameters<Parameters<typeof db.transaction>[0]>[0];
+
+/** The finalizer's existing transaction adapter; no cloud/PDF side effects. */
+export function prescriptionSigningTransaction(
+  tx: Transaction, authorizeSigner: () => Promise<SigningIdentity | null>,
+  requestEvidence: { ipAddress: string | null; userAgent: string | null },
+): SigningTransaction {
+  return {
+    async lockPrescription(id, clinicId) {
+      const [rx] = await tx.select().from(prescriptions)
+        .where(and(eq(prescriptions.id, id), eq(prescriptions.clinicId, clinicId)))
+        .limit(1).for("update");
+      return rx;
+    },
+    authorizeSigner,
+    async getDocument(id, clinicId) {
+      const [document] = await tx.select().from(prescriptionDocuments)
+        .where(and(eq(prescriptionDocuments.prescriptionId, id), eq(prescriptionDocuments.clinicId, clinicId)))
+        .limit(1);
+      return document;
+    },
+    async getPdfContext(rx) {
+      const [patient] = await tx.select().from(patients)
+        .where(and(eq(patients.id, rx.patientId), eq(patients.clinicId, rx.clinicId)))
+        .limit(1).for("share");
+      const [clinic] = await tx.select().from(clinics)
+        .where(and(eq(clinics.id, rx.clinicId), eq(clinics.isActive, true)))
+        .limit(1).for("share");
+      if (!patient || !clinic) throw new PrescriptionError(404, "Prescription not found");
+      let encounterId: number | null = null;
+      if (rx.batchId) {
+        const [batch] = await tx.select().from(prescriptionBatches)
+          .where(and(eq(prescriptionBatches.id, rx.batchId),
+            eq(prescriptionBatches.clinicId, rx.clinicId), eq(prescriptionBatches.patientId, rx.patientId)))
+          .limit(1).for("share");
+        if (!batch) throw new PrescriptionError(409, "Prescription batch linkage invalid");
+        encounterId = batch.encounterId;
+        if (encounterId) {
+          const [encounter] = await tx.select({ id: clinicalEncounters.id }).from(clinicalEncounters)
+            .where(and(eq(clinicalEncounters.id, encounterId), eq(clinicalEncounters.clinicId, rx.clinicId),
+              eq(clinicalEncounters.patientId, rx.patientId))).limit(1).for("share");
+          if (!encounter) throw new PrescriptionError(409, "Originating encounter linkage invalid");
+        }
+      }
+      return {
+        patientName: `${patient.firstName} ${patient.lastName}`, patientDob: patient.dateOfBirth,
+        patientAddress: patient.address, patientPhone: patient.phone,
+        clinicName: clinic.name, clinicAddress: clinic.address, clinicPhone: clinic.phone, clinicFax: clinic.fax,
+        // Never fetch an external URL while rendering a historical document.
+        clinicLogo: clinic.clinicLogo ?? null, encounterId,
+      };
+    },
+    async commitSnapshot(rx, snapshot) {
+      const signedAt = new Date(snapshot.signedAt);
+      const [signed] = await tx.update(prescriptions).set({
+        status: "signed", signedAt, signedByUserId: snapshot.signerUserId,
+        prescriberUserId: snapshot.signerUserId, signedSnapshot: snapshot,
+        prescriberNameSnapshot: snapshot.data.prescriberName,
+        prescriberTitleSnapshot: snapshot.data.prescriberTitle,
+        prescriberNpiSnapshot: snapshot.data.prescriberNpi,
+        prescriberLicenseSnapshot: snapshot.data.prescriberLicense,
+        prescriberLicenseStateSnapshot: snapshot.data.prescriberLicenseState,
+        updatedAt: signedAt,
+      }).where(and(eq(prescriptions.id, rx.id), eq(prescriptions.clinicId, rx.clinicId),
+        eq(prescriptions.status, "draft"), sql`${prescriptions.signedSnapshot} IS NULL`))
+        .returning({ id: prescriptions.id });
+      if (!signed) throw new PrescriptionError(409, "Prescription is already finalized");
+      await tx.insert(prescriptionAuditEvents).values({
+        prescriptionId: rx.id, clinicId: rx.clinicId,
+        actorUserId: snapshot.signerUserId, action: "signed",
+        details: {
+          snapshotVersion: snapshot.version, snapshotHash: snapshot.sha256,
+          reviewHash: snapshot.reviewHash, signingIntent: true,
+          authenticationStatement: snapshot.authenticationStatement,
+          classification: snapshot.classification, signedAt: snapshot.signedAt,
+          ...requestEvidence,
+        },
+      });
+    },
+  };
+}
diff --git a/server/prod-migrate.sql b/server/prod-migrate.sql
index 4c2b8c877bc9890053ea271bacc0614eb281b28d..176e311c94de3f4a57c2da5e67ce9bdc7937bfd6 100644
--- a/server/prod-migrate.sql
+++ b/server/prod-migrate.sql
@@ -5,6 +5,41 @@
 -- ============================================================
 
 -- ── users ───────────────────────────────────────────────────
+-- Prescription snapshot release: PREPARATION ONLY; never run without approval.
+-- Existing signing-time facts and artifacts are deliberately not backfilled.
+ALTER TABLE IF EXISTS prescription_batches ADD COLUMN IF NOT EXISTS encounter_id integer REFERENCES clinical_encounters(id);
+ALTER TABLE IF EXISTS prescriptions ADD COLUMN IF NOT EXISTS signed_snapshot jsonb;
+
+CREATE OR REPLACE FUNCTION protect_prescription_signed_facts()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  IF TG_OP = 'DELETE' THEN
+    IF OLD.signed_at IS NOT NULL OR OLD.signed_snapshot IS NOT NULL THEN
+      RAISE EXCEPTION 'Signed prescription evidence cannot be deleted';
+    END IF;
+    RETURN OLD;
+  END IF;
+  IF OLD.signed_at IS NOT NULL OR OLD.signed_snapshot IS NOT NULL THEN
+    IF (to_jsonb(NEW) - ARRAY['status','cancelled_at','cancelled_by_user_id',
+        'cancellation_reason','updated_at'])
+       IS DISTINCT FROM
+       (to_jsonb(OLD) - ARRAY['status','cancelled_at','cancelled_by_user_id',
+        'cancellation_reason','updated_at'])
+       OR NEW.status = 'draft' THEN
