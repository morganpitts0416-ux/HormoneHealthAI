@@ -0,0 +1,34 @@
+-- PREPARED ONLY. Apply solely to an explicitly approved isolated environment.
+-- No historical values are reconstructed, and no existing artifacts are deleted.
+ALTER TABLE prescription_batches
+  ADD COLUMN IF NOT EXISTS encounter_id integer REFERENCES clinical_encounters(id);
+ALTER TABLE prescriptions ADD COLUMN IF NOT EXISTS signed_snapshot jsonb;
+
+-- Protect signed facts even against accidental future unrestricted update paths.
+-- Cancellation/status metadata may change, but medication, linkage and signing
+-- evidence cannot. Legacy signed records remain legacy, never reconstructed.
+CREATE OR REPLACE FUNCTION protect_prescription_signed_facts()
+RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  IF TG_OP = 'DELETE' THEN
+    IF OLD.signed_at IS NOT NULL OR OLD.signed_snapshot IS NOT NULL THEN
+      RAISE EXCEPTION 'Signed prescription evidence cannot be deleted';
+    END IF;
+    RETURN OLD;
+  END IF;
+  IF OLD.signed_at IS NOT NULL OR OLD.signed_snapshot IS NOT NULL THEN
+    IF (to_jsonb(NEW) - ARRAY['status','cancelled_at','cancelled_by_user_id',
+        'cancellation_reason','updated_at'])
+       IS DISTINCT FROM
+       (to_jsonb(OLD) - ARRAY['status','cancelled_at','cancelled_by_user_id',
+        'cancellation_reason','updated_at'])
+       OR NEW.status = 'draft' THEN
+      RAISE EXCEPTION 'Signed prescription facts are immutable';
+    END IF;
+  END IF;
+  RETURN NEW;
+END;
+$$;
+DROP TRIGGER IF EXISTS prescription_signed_facts_guard ON prescriptions;
+CREATE TRIGGER prescription_signed_facts_guard BEFORE UPDATE OR DELETE ON prescriptions
+FOR EACH ROW EXECUTE FUNCTION protect_prescription_signed_facts();
