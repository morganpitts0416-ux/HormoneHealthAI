@@ -0,0 +1,58 @@
+/** Versioned signing-time facts. Dates are ISO strings, never live account lookups. */
+export interface SignedPrescriptionSnapshot {
+  version: 1;
+  prescriptionId: number;
+  clinicId: number;
+  patientId: number;
+  batchId: number | null;
+  encounterId: number | null;
+  signerUserId: number;
+  signedAt: string;
+  signingIntent: true;
+  reviewHash: string;
+  classification: Record<string, unknown>;
+  authenticationStatement: string;
+  data: {
+    clinicName: string;
+    clinicAddress: string;
+    clinicPhone: string;
+    clinicFax?: string | null;
+    clinicLogo?: string | null;
+    patientName: string;
+    patientDob: string | null;
+    patientAddress?: string | null;
+    patientPhone?: string | null;
+    medicationName: string;
+    strength?: string | null;
+    dosageForm?: string | null;
+    dose?: string | null;
+    route?: string | null;
+    frequency?: string | null;
+    sig: string;
+    quantity: string;
+    daysSupply?: number | null;
+    refills: number;
+    indication?: string | null;
+    substitutionAllowed: boolean;
+    pharmacyName?: string | null;
+    pharmacyAddress?: string | null;
+    pharmacyPhone?: string | null;
+    pharmacyFax?: string | null;
+    prescriberName: string;
+    prescriberTitle?: string | null;
+    prescriberNpi: string;
+    prescriberLicense: string;
+    prescriberLicenseState: string;
+    signatureImage: string;
+  };
+  sha256: string;
+}
+
+/** JSONB can reorder object keys. Canonicalize before hashing and verification. */
+export function canonicalSnapshotJson(value: unknown): string {
+  if (value === null || typeof value !== "object") return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(canonicalSnapshotJson).join(",")}]`;
+  return `{${Object.keys(value).sort().map(key =>
+    `${JSON.stringify(key)}:${canonicalSnapshotJson((value as Record<string, unknown>)[key])}`
+  ).join(",")}}`;
+}
