+  const api = (path: string, user: number | null = 7, method = "GET", data?: unknown) =>
+    fetch(base + path, { method, headers: { "Content-Type": "application/json",
+      ...(user ? { Cookie: cookie.get(user)! } : {}) }, body: data === undefined ? undefined : JSON.stringify(data) });
+  const draftBody = {
+    medicationName: "Synthetic Medication", strength: "10 mg", dosageForm: "tablet",
+    sig: "Take one tablet daily", quantity: "30", refills: 1,
+    pharmacyName: "Synthetic Pharmacy", pharmacyAddress: "100 Synthetic Pharmacy Avenue",
+    pharmacyPhone: "555-0102", pharmacyFax: "555-0103",
+  };
+  async function create() {
+    const response = await api("/api/patients/20/prescriptions/batch", 7, "POST",
+      { medications: [draftBody, { ...draftBody, sig: "Take one tablet each morning" }], encounterId: 30 });
+    expect(response.status).toBe(201);
+    return (await response.json()).prescriptions;
+  }
+  async function sign(id: number, user = 7) {
+    const review = await api(`/api/prescriptions/${id}`, user);
+    const data = await review.json();
+    return api(`/api/prescriptions/${id}/sign`, user, "POST", { confirmSign: true, reviewHash: data.reviewHash });
+  }
+  beforeAll(async () => {
+    if (!socket?.startsWith("/tmp/cliniq-rx-pg.") || socket.includes("..")) throw new Error("Private synthetic socket required");
